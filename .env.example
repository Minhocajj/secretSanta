# Copy this file to ".env", fill in the values, then restart "npm run dev".
# The EmailJS values come from https://dashboard.emailjs.com (see README.md for the full setup).
# They are only used by the quick draw (/quick) on your own machine. Sessions send through the
# Worker (see .dev.vars.example), and a public deployment should not set them at all.
#
# Only PUBLIC identifiers belong here. Everything prefixed with VITE_ is bundled into
# the browser code, so never put your EmailJS Private Key (accessToken) in this file.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Set to "true" to run the whole flow without sending any email.
VITE_EMAILJS_DRY_RUN=false

# Supabase project (Connect dialog). Use the PUBLISHABLE key (sb_publishable_...), never a
# secret or service_role key. Leave empty to run without sessions.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Base URL used in the links you share (for example https://secretsanta.example.workers.dev).
# Leave empty to use the address the app is opened from.
VITE_PUBLIC_URL=
