# Copy this file to ".env", fill in the values, then restart "npm run dev".
# The values come from https://dashboard.emailjs.com (see README.md for the full setup).
#
# Only PUBLIC identifiers belong here. Everything prefixed with VITE_ is bundled into
# the browser code, so never put your EmailJS Private Key (accessToken) in this file.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Set to "true" to run the whole flow without sending any email.
VITE_EMAILJS_DRY_RUN=false
